<launch>
    <!-- =========================================================
         仅测试视觉节点：相机 + image_proc + 视觉节点。
         无机械臂 / 策略 / 控制 / MoveIt。
         视觉核心输出（不依赖 TF）：
           /vision/board_state, /vision/debug_image, /vision/pick_depth_debug
         切换实现：vision_node:=vision_processor_node_dexined
         ========================================================= -->
    <arg name="vision_node" default="vision_processor_node_cpp" />
    <arg name="color_edge_thresh" default="22" /><!-- 命令行可覆盖,边看 debug_edges 边扫 -->
    <arg name="color_edge_min_area" default="40" /><!-- 颜色边最小连通面积:滤掉掉漆零碎边,掉漆还切就调大 -->
    <arg name="use_dexined_for_split" default="true" /><!-- 或上DexiNed强边切同色贴碰块;不稳就设false纯颜色 -->
    <arg name="temporal_alpha" default="0.3" /><!-- 输入帧EMA时间平均系数,0=关;静止料堆抑噪/抗闪,越小越稳(更滞后) -->
    <arg name="min_template_iou" default="0.40" /><!-- 收回正常值:挡掉粘连大blob/边缘错配(之前0.25是放块的临时档) -->

    <!-- 1. RealSense 相机（带对齐深度，供抓取点 Z 采样） -->
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="align_depth" value="true" />
    </include>

    <!-- 1.5 启动后加载固定曝光/白平衡（camera_config 里调好的，避免每次手调）。 -->
    <node pkg="dynamic_reconfigure" type="dynparam" name="load_rgb_cfg" output="screen"
          args="load /camera/rgb_camera $(find tly)/config/camera_config"
          launch-prefix="bash -c 'sleep 6; exec $0 $@'" />

    <!-- 2. 生成 /camera/color/image_rect_color -->
    <!-- <node pkg="image_proc" type="image_proc" name="image_proc" ns="/camera/color" output="screen" /> -->

    <!-- 3. 视觉节点 -->
    <node pkg="tly" type="$(arg vision_node)" name="vision_processor_node" output="screen">
        <param name="image_topic" value="/camera/color/image_raw" />
        <param name="camera_info_topic" value="/camera/color/camera_info" />
        <param name="assume_image_rectified" value="true" />
        <param name="table_frame" value="table_frame" />

        <!-- 角度与姿态偏置 -->
        <param name="publish_angle_in_table_frame" value="false" />
        <param name="angle_axis_probe_px" value="40.0" />
        <param name="contour_axis_probe_px" value="50.0" />
        <param name="use_contour_axis_yaw" value="false" />

        <!-- Pick point mode -->
        <param name="pick_point_mode" value="hybrid" />
        <rosparam param="distance_pick_shapes">[3, 4]</rosparam>

        <!-- ROI -->
        <param name="roi_x_min" value="120" />
        <param name="roi_y_min" value="40" />
        <param name="roi_x_max" value="723" />
        <param name="roi_y_max" value="684" />

        <!-- 黑白分割 -->
        <param name="threshold_mode" value="otsu" />
        <param name="manual_dark_threshold" value="105" />
        <param name="blur_kernel" value="5" />
        <param name="close_kernel" value="3" />
        <param name="open_kernel" value="3" />

        <!-- 发光板掩码 -->
        <!-- 彩色块场景务必开：用 HSV 饱和度抓彩色块(含偏亮红/黄)，避免灰度暗阈值漏块。
             竞赛若把画面压成黑白(黑块)则设 false，走灰度暗阈值即可。 -->
        <param name="use_saturation_foreground" value="true" />
        <param name="use_lightboard_mask" value="true" />
        <param name="lightboard_min_area_ratio" value="0.08" />
        <param name="lightboard_close_kernel" value="15" />

        <!-- 面积过滤 -->
        <param name="min_area" value="900" />
        <param name="max_area" value="50000" />
        <param name="min_contour_fill_ratio" value="0.18" />
        <param name="max_contour_fill_ratio" value="1.0" /><!-- 1.0：别误杀轴对齐的田/一字(填满bbox) -->

        <!-- 模板匹配 -->
        <!-- 分水岭分出来的贴碰块边界略有波纹，IoU 会偏低，先放宽到 0.25 验证出框；
             稳定出货后再按实际 IoU 收紧。 -->
        <param name="min_template_iou" value="$(arg min_template_iou)" />
        <!-- 匹配前轮廓多边形近似 eps(占周长比)：拉直分水岭波纹边，提高分类准度。
             0=关闭；过大(>0.04)会把 L/T/Z 的真实拐角也抹平。形状对了再把 IoU 收回 ~0.4。 -->
        <param name="poly_approx_eps_ratio" value="0.02" />
        <!-- 同帧去重：质心距(全分辨率px)小于此视为同块,留高分;0=关。密集小块若被误并就调小 -->
        <param name="nms_center_dist_px" value="35" />
        <!-- DexiNed 边缘阈值(现仅 debug 用,切割已改走颜色边界) -->
        <param name="dexined_thresh" value="180" />
        <!-- 颜色边界阈值(Lab a/b 梯度,0-255)：异色块边界色度突变→切开。
             块间没切开(粘连)→调小(12~16);把一个块切碎(块内色不匀)→调大(28~35)。
             debug_edges 现在显示的就是这个颜色边界,可对照着调。 -->
        <param name="color_edge_thresh" value="$(arg color_edge_thresh)" />
        <param name="color_edge_min_area" value="$(arg color_edge_min_area)" />
        <param name="use_dexined_for_split" value="$(arg use_dexined_for_split)" />
        <param name="temporal_alpha" value="$(arg temporal_alpha)" />
        <param name="template_size" value="72" />
        <param name="template_angle_step" value="10" />
        <param name="template_refine_step" value="1" />

        <!-- 跟踪/稳定 -->
        <param name="track_history_len" value="13" /><!-- 形状投票窗口:大些更稳(放料后收敛稍慢) -->
        <param name="stable_min_frames" value="3" />
        <param name="stable_max_px_std" value="8.0" />
        <param name="stable_max_angle_std_deg" value="15.0" />
        <param name="publish_only_stable" value="true" />
        <param name="stable_publish_max_missed" value="8" /><!-- 边缘块偶尔漏检也保持发布,稳住库存计数 -->
        <param name="max_missed_frames" value="15" />
        <param name="track_match_gate_px" value="85.0" />
        <param name="track_match_gate_m" value="0.055" />

        <!-- 深度抓取 Z 采样 -->
        <param name="use_depth_pick_z" value="true" />
        <param name="depth_topic" value="/camera/aligned_depth_to_color/image_raw" />
        <param name="depth_sample_radius_px" value="4" />
        <param name="depth_sample_in_raw_color" value="true" />
    </node>
</launch>
