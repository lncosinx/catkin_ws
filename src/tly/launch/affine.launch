<launch>
    <arg name="robot_ip" default="192.168.1.228" />

    <!-- 单块放置测试目标。红色一字块横放覆盖 (6,2)(6,3)(6,4)(6,5) 时，中心是 row=6.0 col=3.5 -->
    <arg name="target_row" default="6.0" />
    <arg name="target_col" default="3.5" />
    <arg name="target_way" default="0" />
    <arg name="place_z_extra_margin" default="0.0" />

    <!-- 1. 启动官方真机 MoveIt 控制环境 -->
    <include file="$(find xarm6_moveit_config)/launch/realMove_exec.launch">
        <arg name="robot_ip" value="$(arg robot_ip)" />
    </include>

    <!-- 【核心新增】：发布吸盘 TCP！因为新的手眼标定依赖这个 frame，不发会导致相机 TF 断裂 -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="suction_tcp_broadcaster" 
          args="0.00046 -0.00026 0.06962 0 0 0 link6 link_tcp" />

    <!-- 2. 启动 RealSense -->
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="align_depth" value="true" />
    </include>

    <!-- 3. 启动手眼标定发布器 -->
    <include file="$(find easy_handeye)/launch/publish.launch">
        <arg name="eye_on_hand" value="true" />
        <arg name="namespace_prefix" value="xarm6_realsense_calibration" />
    </include>

    <!-- 4. 加载增强标定 YAML -->
    <rosparam file="$(find tly)/config/tetris_config.yaml" command="load" />

    <!-- 5. 发布 table_frame -->

    <!-- 6. 生成 rectified color image -->
    <node pkg="image_proc" type="image_proc" name="image_proc" ns="/camera/color" output="screen" />

    <!-- 7. 视觉节点 -->
    <node pkg="tly" type="vision_processor_node.py" name="vision_processor_node" output="screen"
          launch-prefix="bash -c 'sleep 6; exec $0 $@'">
        <param name="image_topic" value="/camera/color/image_rect_color" />
        <param name="camera_info_topic" value="/camera/color/camera_info" />
        <param name="assume_image_rectified" value="true" />

        <param name="pick_point_mode" value="centroid" />

        <!-- 单块测试可适当扩大 ROI；这里保持你当前左侧区域设置 -->
        <param name="roi_x_min" value="270" />
        <param name="roi_y_min" value="30" />
        <param name="roi_x_max" value="910" />
        <param name="roi_y_max" value="705" />

        <param name="threshold_mode" value="otsu" />
        <param name="manual_dark_threshold" value="105" />
        <param name="blur_kernel" value="5" />
        <param name="close_kernel" value="3" />
        <param name="open_kernel" value="3" />

        <param name="min_area" value="900" />
        <param name="max_area" value="50000" />

        <param name="min_template_iou" value="0.42" />
        <param name="template_size" value="96" />
        <param name="template_angle_step" value="5" />
        <param name="template_refine_step" value="1" />

        <param name="track_history_len" value="9" />
        <param name="stable_min_frames" value="5" />
        <param name="stable_max_px_std" value="3.0" />
        <param name="stable_max_angle_std_deg" value="5.0" />
        <param name="publish_only_stable" value="true" />

        <param name="publish_debug_foreground" value="true" />
        <param name="publish_debug_edges" value="true" />
        <param name="publish_debug_pose_array" value="true" />
    </node>

</launch>