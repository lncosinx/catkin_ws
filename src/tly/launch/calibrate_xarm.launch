<launch>
    <arg name="eye_on_hand" default="true" />

    <!-- true=手动 freehand(本栈默认,无需 MoveIt)；false=easy_handeye 自动采样【需要 MoveIt move_group】，
         本标定栈是纯 xArm 原生驱动、没起 move_group，设 false 会让 robot.py 因缺 get_planning_scene 而死。
         想自动采样请用原生驱动的自定义 look-at 脚本，别在这里设 false。 -->
    <arg name="freehand_robot_movement" default="true" />
    <!-- 自动采样运动范围：转角越大旋转越多样、手眼越准，但太大会丢标记/碰撞。 -->
    <arg name="rotation_delta_degrees" default="25" />
    <arg name="translation_delta_meters" default="0.1" />
    <!-- 速度/加速度 = joint_limits 的比例(0~1)。先用 0.1 慢速，确认安全再调快。 -->
    <arg name="robot_velocity_scaling" default="0.1" />
    <arg name="robot_acceleration_scaling" default="0.1" />
    <!-- 自动采样用的 MoveIt 规划组名：xArm6 的 SRDF 组名是 xarm6（不是 easy_handeye 默认的 manipulator）。 -->
    <arg name="move_group" default="xarm6" />
    <arg name="move_group_namespace" default="/" />
    <!-- 默认不另起 easy_handeye 的 rviz（MoveIt 那套已带 rviz），避免双开。 -->
    <arg name="start_rviz" default="false" />

    <include file="$(find easy_handeye)/launch/calibrate.launch">
        <arg name="eye_on_hand" value="$(arg eye_on_hand)" />

        <arg name="namespace_prefix" value="xarm6_realsense_calibration" />

        <arg name="robot_base_frame" value="link_base" />

        <!-- 【核心改进 2】：将标定末端从法兰盘 (link6) 改为刚创建的实际吸盘尖端 (link_tcp) -->
        <arg name="robot_effector_frame" value="link_tcp" />

        <arg name="tracking_base_frame" value="camera_link" />

        <arg name="tracking_marker_frame" value="charuco_board_frame" />

        <arg name="freehand_robot_movement" value="$(arg freehand_robot_movement)" />
        <!-- 自动采样(MoveIt)参数；freehand=true 时这些被忽略。 -->
        <arg name="move_group" value="$(arg move_group)" />
        <arg name="move_group_namespace" value="$(arg move_group_namespace)" />
        <arg name="start_rviz" value="$(arg start_rviz)" />
        <arg name="rotation_delta_degrees" value="$(arg rotation_delta_degrees)" />
        <arg name="translation_delta_meters" value="$(arg translation_delta_meters)" />
        <arg name="robot_velocity_scaling" value="$(arg robot_velocity_scaling)" />
        <arg name="robot_acceleration_scaling" value="$(arg robot_acceleration_scaling)" />
    </include>
</launch>