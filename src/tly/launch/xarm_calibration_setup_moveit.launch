<launch>
    <!-- 手眼标定栈（MoveIt + easy_handeye 自动采样）。区别于纯原生的 xarm_calibration_setup.launch(freehand)。
         注意：标定用 MoveIt 没问题；生产抓放才必须走原生直线 move_line（避免规划出曲线把吸住的方块转向）。
         规划器用 OMPL —— 不用 Pilz（Pilz 偶发关节加速度突增）。 -->
    <arg name="robot_ip" default="192.168.1.216" />

    <!-- ChArUco 标定板参数 (calib.io: 列11 x 行8, 方格15mm, 标记11mm, DICT_4X4) -->
    <arg name="squares_x"     default="11" />
    <arg name="squares_y"     default="8" />
    <arg name="square_length" default="0.015" />
    <arg name="marker_length" default="0.011" />
    <arg name="dictionary"    default="DICT_4X4_50" />

    <!-- 自动采样：速度/加速度(关节限速比例 0~1，先慢)，以及运动范围 -->
    <arg name="robot_velocity_scaling" default="0.1" />
    <arg name="robot_acceleration_scaling" default="0.1" />
    <arg name="rotation_delta_degrees" default="25" />
    <arg name="translation_delta_meters" default="0.1" />

    <!-- xArm6 MoveIt 真机栈：自带 xarm6_server(use_moveit) + 轨迹控制器 + move_group + robot_description/SRDF。
         pipeline=ompl（默认是 Pilz，对 easy_handeye 的通用 plan() 不友好且偶发加速度突增）。 -->
    <include file="$(find xarm6_moveit_config)/launch/realMove_exec.launch">
        <arg name="robot_ip"    value="$(arg robot_ip)" />
        <arg name="pipeline"    value="ompl" />
        <arg name="show_rviz"   value="true" />
        <arg name="no_gui_plan" value="false" />
    </include>

    <!-- RealSense（对齐深度；标定只需彩色，深度可留作其它自检） -->
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="align_depth" value="true" />
        <arg name="filters" value="spatial,temporal,hole_filling" />
    </include>

    <!-- 吸盘末端 TCP 静态 TF（与原生 setup 一致）。MoveIt 的 robot_description 不含 link_tcp，
         靠这条静态 TF 挂到 link6 下；easy_handeye 的 robot_effector_frame=link_tcp 由此可解析。 -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="suction_tcp_broadcaster"
          args="0.00075 0.0004 0.068 0 0 0 link6 link_tcp" />

    <!-- ChArUco 整板检测，广播 camera_color_optical_frame -> charuco_board_frame -->
    <node pkg="tly" type="charuco_tracker.py" name="charuco_tracker" output="screen">
        <param name="image"       value="/camera/color/image_raw"/>
        <param name="camera_info" value="/camera/color/camera_info"/>
        <param name="camera_optical_frame" value="camera_color_optical_frame"/>
        <param name="board_frame" value="charuco_board_frame"/>
        <param name="squares_x"     value="$(arg squares_x)"/>
        <param name="squares_y"     value="$(arg squares_y)"/>
        <param name="square_length" value="$(arg square_length)"/>
        <param name="marker_length" value="$(arg marker_length)"/>
        <param name="dictionary"    value="$(arg dictionary)"/>
    </node>

    <!-- easy_handeye：自动采样(freehand=false) + 规划组 xarm6 + 慢速 -->
    <include file="$(find tly)/launch/calibrate_xarm.launch">
        <arg name="freehand_robot_movement"  value="false" />
        <arg name="move_group"               value="xarm6" />
        <arg name="robot_velocity_scaling"   value="$(arg robot_velocity_scaling)" />
        <arg name="robot_acceleration_scaling" value="$(arg robot_acceleration_scaling)" />
        <arg name="rotation_delta_degrees"   value="$(arg rotation_delta_degrees)" />
        <arg name="translation_delta_meters" value="$(arg translation_delta_meters)" />
    </include>
</launch>
