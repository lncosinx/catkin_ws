<launch>
    <arg name="robot_ip" default="192.168.1.228" />

    <include file="$(find xarm_bringup)/launch/xarm6_server.launch">
        <arg name="robot_ip" value="$(arg robot_ip)" />
    </include>

    <include file="$(find xarm6_moveit_config)/launch/realMove_exec.launch">
        <arg name="robot_ip" value="$(arg robot_ip)" />
    </include>

    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="align_depth" value="true" />
    </include>

    <include file="$(find xarm_description)/launch/xarm6_upload.launch" />

    <include file="$(find easy_handeye)/launch/publish.launch">
        <arg name="eye_on_hand" value="true" />
        <arg name="namespace_prefix" value="xarm6_realsense_calibration" /> [cite: 4]
    </include>

    <node pkg="tly" type="vision_processor_node.py" name="vision_processor_node" output="screen" />

    <node pkg="tly" type="strategy_node" name="strategy_node" 
          launch-prefix="bash -c 'sleep 15; $0 $@'" 
          output="screen" />

    <node pkg="tly" type="xarm_controller_node" name="xarm_controller_node" 
          launch-prefix="bash -c 'sleep 25; $0 $@'" 
          output="screen" />

</launch>