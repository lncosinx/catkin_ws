<launch>
    <arg name="robot_ip" default="192.168.1.216" />
    <arg name="place_z_extra_margin" default="0.001" />
    <!-- 视觉实现: vision_processor_node_cpp (经典) 或 vision_processor_node_dexined -->
    <arg name="vision_node" default="vision_processor_node_dexined" />

    <!-- 1. 启动官方真机 MoveIt 控制环境 -->
    <include file="$(find xarm6_moveit_config)/launch/realMove_exec.launch">
        <arg name="robot_ip" value="$(arg robot_ip)" />
    </include>

    <!-- 3. 启动 RealSense -->
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="align_depth" value="true" />
    </include>

    <!-- 4. 启动手眼标定发布器 -->
    <include file="$(find easy_handeye)/launch/publish.launch">
        <arg name="eye_on_hand" value="true" />
        <arg name="namespace_prefix" value="xarm6_realsense_calibration" />
    </include>

    <!-- 5. 加载增强标定 YAML -->
    <rosparam file="$(find tly)/config/tetris_config.yaml" command="load" />

    <!-- 6. 发布 table_frame -->

    <!-- 7. 生成 rectified color image -->
    <node pkg="image_proc" type="image_proc" name="image_proc" ns="/camera/color" output="screen" />

    <!-- 8. 视觉节点 -->
    <!-- 4. 相机 + image_proc + 视觉节点（复用 test_vision.launch） -->
    <include file="$(find tly)/launch/test_vision.launch">
        <arg name="vision_node" value="$(arg vision_node)" />
    </include>

    <!-- 9. Pilz 控制节点 -->
    <node pkg="tly" type="xarm_controller_node" name="xarm_controller_node" output="screen"
      launch-prefix="bash -c 'sleep 4; exec $0 $@'">

    <!-- Frames -->
    <param name="eef_frame" value="link_tcp" />
    <param name="base_frame" value="link_base" />
    <param name="camera_frame" value="camera_color_optical_frame" />
    <param name="camera_info_topic" value="/camera/color/camera_info" />
    <param name="assume_image_rectified" value="true" />

    <!-- Calibration / geometry -->
    <param name="use_true_pick_plane" value="true" />
    <param name="use_pick_affine_correction" value="true" />
    <param name="require_pick_plane" value="true" />
    <param name="require_board_map" value="true" />
    <param name="require_place_z_map" value="true" />
    <param name="pick_yaw_offset_deg" value="90.0" />
    <param name="yaw_homography_probe_px" value="30.0" />
    <param name="yaw_homography_v_sign" value="-1.0" />

    <!-- Real board and placement -->
    <param name="place_release_z_margin" value="0.004" />
    <param name="tcp_pick_offset_z" value="0.001" />
    <param name="tcp_pick_offset_x" value="0.0" />
    <param name="tcp_pick_offset_y" value="0.0" />
    <param name="tcp_place_offset_x" value="0.0" />
    <param name="tcp_place_offset_y" value="0.0" />
    <param name="tcp_place_offset_z" value="0.0" />

    <!-- Speed: first test must be slow -->
    <param name="velocity_scale" value="0.04" />
    <param name="acceleration_scale" value="0.03" />
    <param name="max_velocity_scale_allowed" value="0.08" />
    <param name="max_acceleration_scale_allowed" value="0.06" />

    <!-- Safety: do not block normal total joint rotation, only block bad trajectory segments -->
    <param name="enable_joint_jump_guard" value="false" />
    <param name="enable_trajectory_guard" value="true" />
    <param name="warn_ptp_joint_jump_rad" value="1.20" />
    <param name="max_lin_branch_jump_rad" value="1.20" />
    <param name="max_traj_segment_joint_delta_rad" value="0.35" />
    <param name="lock_loaded_roll_pitch" value="true" />
    <param name="use_loaded_lin_transport" value="true" />

    <!-- First verify one block only -->
    <param name="max_tasks_per_plan" value="1" />

    <!-- IO -->
    <param name="suction_io_num" value="1" />
</node>

    <!-- 10. 单块测试节点 -->
    <node pkg="tly" type="single_block_test.py" name="single_block_tester" output="screen"
          launch-prefix="bash -c 'sleep 5; exec $0 $@'">
        <rosparam param="target_cells">[[0,0],[1,0],[0,1],[1,1]]</rosparam>
        <param name="target_way" value="0" />
        <param name="use_detected_angle" value="true" />
        <param name="override_pick_angle" value="0" />
        <param name="use_extended_plan" value="true" />
    </node>
</launch>