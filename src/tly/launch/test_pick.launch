<launch>
    <arg name="robot_ip" default="192.168.1.228" />
    <arg name="place_z_extra_margin" default="0.001" />

    <!-- 1. 启动官方真机 MoveIt 控制环境 -->
    <include file="$(find xarm6_moveit_config)/launch/realMove_exec.launch">
        <arg name="robot_ip" value="$(arg robot_ip)" />
    </include>

    <!-- 3. 启动 RealSense -->
    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="align_depth" value="true" />
    </include>

    <!-- 4. 启动手眼标定发布器 -->
    <include file="$(find easy_handeye)/launch/publish.launch">
        <arg name="eye_on_hand" value="true" />
        <arg name="namespace_prefix" value="xarm6_realsense_calibration" />
    </include>

    <!-- 5. 加载增强标定 YAML -->
    <rosparam file="$(find tly)/config/tetris_config.yaml" command="load" />

    <!-- 6. 发布 table_frame -->
    <node pkg="tly" type="table_tf_broadcaster.py" name="table_tf_broadcaster" output="screen" />

    <!-- 7. 生成 rectified color image -->
    <node pkg="image_proc" type="image_proc" name="image_proc" ns="/camera/color" output="screen" />

    <!-- 8. 视觉节点 -->
    <node pkg="tly" type="vision_processor_node_cpp" name="vision_processor_node" output="screen">
        <param name="image_topic" value="/camera/color/image_rect_color" />
        <param name="camera_info_topic" value="/camera/color/camera_info" />
        <param name="assume_image_rectified" value="true" />
        <param name="table_frame" value="table_frame" />
        
        <!-- 角度与姿态偏置 -->
        <param name="publish_angle_in_table_frame" value="false" />
        <param name="angle_axis_probe_px" value="40.0" />
        <param name="contour_axis_probe_px" value="50.0" />
        <!-- 核心修改 1：关闭轮廓轴线推断，彻底消除 T/L 块的角度横跳，信任 1° 精度的模板角度 -->
        <param name="use_contour_axis_yaw" value="false" />

        <!-- Pick point mode: hybrid 模式对 L 型使用形心，更稳固 -->
        <param name="pick_point_mode" value="centroid" />
        <!-- <rosparam param="distance_pick_shapes">[2, 3, 4]</rosparam> -->

        <!-- Wider ROI for current RealSense view. -->
        <param name="roi_x_min" value="343" />
        <param name="roi_y_min" value="60" />
        <param name="roi_x_max" value="910" />
        <param name="roi_y_max" value="630" />

        <!-- Black block segmentation on white lightboard. -->
        <param name="threshold_mode" value="otsu" />
        <param name="manual_dark_threshold" value="105" />
        <param name="blur_kernel" value="5" />
        <param name="close_kernel" value="3" />
        <param name="open_kernel" value="3" />

        <!-- Lightboard mask: 仅在发光板亮区内寻找黑色积木 -->
        <param name="use_saturation_foreground" value="false" />
        <param name="use_lightboard_mask" value="true" />
        <param name="lightboard_min_area_ratio" value="0.08" />
        <param name="lightboard_close_kernel" value="15" />

        <!-- Area filtering at 1280x720. -->
        <param name="min_area" value="900" />
        <param name="max_area" value="50000" />
        <param name="min_contour_fill_ratio" value="0.18" />
        <param name="max_contour_fill_ratio" value="0.98" />

        <!-- Topology-enhanced template matching (由于 C++ 中做了全量预计算，refine_step 设为 1 获取最高 1° 精度) -->
        <param name="min_template_iou" value="0.40" />
        <param name="template_size" value="72" />
        <param name="template_angle_step" value="10" />
        <param name="template_refine_step" value="1" />

        <!-- Tracking/stability: faster startup, tolerant to short missed detections. -->
        <param name="track_history_len" value="9" />
        <param name="stable_min_frames" value="2" />
        <!-- 核心修改 2：放宽位置抖动容忍度，防止边缘积木和 L 型距离变换点在几像素内滑动导致误判 -->
        <param name="stable_max_px_std" value="5.0" />
        <param name="stable_max_angle_std_deg" value="15.0" />
        <param name="publish_only_stable" value="true" />
        <param name="stable_publish_max_missed" value="3" />
        <param name="max_missed_frames" value="10" />

        <!-- Track matching gates. -->
        <param name="track_match_gate_px" value="85.0" />
        <param name="track_match_gate_m" value="0.055" />

        <!-- Precise Pose 服务参数 (显式暴露方便后续机械臂微调时修改) -->
        <param name="precise_timeout" value="0.8" />
        <param name="precise_require_stable" value="true" />
        <param name="precise_center_gate_px" value="280.0" />

    </node>

    <!-- 9. Pilz 控制节点 -->
    <node pkg="tly" type="xarm_controller_node" name="xarm_controller_node" output="screen"
      launch-prefix="bash -c 'sleep 4; exec $0 $@'">

    <!-- Frames -->
    <param name="eef_frame" value="link_tcp" />
    <param name="table_frame" value="table_frame" />
    <param name="base_frame" value="link_base" />
    <param name="camera_frame" value="camera_color_optical_frame" />
    <param name="camera_info_topic" value="/camera/color/camera_info" />
    <param name="assume_image_rectified" value="true" />

    <!-- Calibration / geometry -->
    <param name="use_true_pick_plane" value="true" />
    <param name="use_pick_affine_correction" value="true" />
    <param name="require_pick_plane" value="true" />
    <param name="require_board_map" value="true" />
    <param name="require_place_z_map" value="true" />
    <param name="pick_yaw_offset_deg" value="90.0" />
    <param name="yaw_homography_probe_px" value="30.0" />
    <param name="yaw_homography_v_sign" value="-1.0" />

    <!-- Real board and placement -->
    <param name="place_release_z_margin" value="0.004" />
    <param name="tcp_pick_offset_z" value="0.006" />
    <param name="tcp_pick_offset_x" value="0.0007" />
    <param name="tcp_pick_offset_y" value="-0.0009" />
    <param name="tcp_place_offset_x" value="-0.0015" />
    <param name="tcp_place_offset_y" value="-0.0016" />
    <param name="tcp_place_offset_z" value="0.004" />

    <!-- Speed: first test must be slow -->
    <param name="velocity_scale" value="0.04" />
    <param name="acceleration_scale" value="0.03" />
    <param name="max_velocity_scale_allowed" value="0.08" />
    <param name="max_acceleration_scale_allowed" value="0.06" />

    <!-- Safety: do not block normal total joint rotation, only block bad trajectory segments -->
    <param name="enable_joint_jump_guard" value="false" />
    <param name="enable_trajectory_guard" value="true" />
    <param name="warn_ptp_joint_jump_rad" value="1.20" />
    <param name="max_lin_branch_jump_rad" value="1.20" />
    <param name="max_traj_segment_joint_delta_rad" value="0.35" />
    <param name="lock_loaded_roll_pitch" value="true" />
    <param name="use_loaded_lin_transport" value="true" />

    <!-- First verify one block only -->
    <param name="max_tasks_per_plan" value="1" />

    <!-- IO -->
    <param name="suction_io_num" value="1" />
</node>

    <!-- 10. 单块测试节点 -->
    <node pkg="tly" type="single_block_test.py" name="single_block_tester" output="screen"
          launch-prefix="bash -c 'sleep 5; exec $0 $@'">
        <rosparam param="target_cells">[[0,0],[1,0],[0,1],[1,1]]</rosparam>
        <param name="target_way" value="0" />
        <param name="use_detected_angle" value="true" />
        <param name="override_pick_angle" value="0" />
        <param name="use_extended_plan" value="true" />
    </node>
</launch>