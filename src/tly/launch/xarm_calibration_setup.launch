<launch>
    <arg name="robot_ip" default="192.168.1.228" />

    <!-- ChArUco 标定板参数 (calib.io: 列11 x 行8, 方格15mm, 标记11mm, DICT_4X4) -->
    <arg name="squares_x"     default="11" />
    <arg name="squares_y"     default="8" />
    <arg name="square_length" default="0.015" />
    <arg name="marker_length" default="0.011" />
    <arg name="dictionary"    default="DICT_4X4_50" />

    <include file="$(find xarm_bringup)/launch/xarm6_server.launch">
        <arg name="robot_ip" value="$(arg robot_ip)" />
    </include>

    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg name="align_depth" value="true" />
        <arg name="filters" value="spatial,temporal,hole_filling" />
    </include>

    <include file="$(find xarm_description)/launch/xarm6_upload.launch" />

    <!-- 【核心改进 1】：发布吸盘末端 TCP 的静态 TF。数据来自 xArm Studio (单位转为米) -->
    <!-- args 参数顺序: x y z yaw pitch roll parent_frame child_frame -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="suction_tcp_broadcaster" 
          args="0.00046 -0.00026 0.06962 0 0 0 link6 link_tcp" />

    <!-- ChArUco 整板检测，广播 camera_color_optical_frame -> charuco_board_frame -->
    <node pkg="tly" type="charuco_tracker.py" name="charuco_tracker" output="screen">
        <param name="image"       value="/camera/color/image_raw"/>
        <param name="camera_info" value="/camera/color/camera_info"/>
        <param name="camera_optical_frame" value="camera_color_optical_frame"/>
        <param name="board_frame" value="charuco_board_frame"/>
        <param name="squares_x"     value="$(arg squares_x)"/>
        <param name="squares_y"     value="$(arg squares_y)"/>
        <param name="square_length" value="$(arg square_length)"/>
        <param name="marker_length" value="$(arg marker_length)"/>
        <param name="dictionary"    value="$(arg dictionary)"/>
    </node>

    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
        <param name="robot_description" value="/xarm/robot_description" />
        <remap from="joint_states" to="/xarm/joint_states" />
    </node>

    <include file="$(find tly)/launch/calibrate_xarm.launch" />
</launch>