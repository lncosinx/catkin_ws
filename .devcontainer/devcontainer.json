{
    "name": "xArm-Full-Workspace",
    "image": "xarm_lucky:latest",
    "workspaceFolder": "/root/catkin_ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/root/catkin_ws,type=bind",
    "runArgs": [
        "--gpus",
        "all",
        "--net=host",
        "--privileged",
        "--device=/dev/bus/usb",
        "-v",
        "/tmp/.X11-unix:/tmp/.X11-unix"
    ],
    // 环境变量：等同于 --env="DISPLAY"
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "NVIDIA_VISIBLE_DEVICES": "all",
        "NVIDIA_DRIVER_CAPABILITIES": "all",
        "QT_X11_NO_MITSHM": "1"
    },
    // 进容器后自动执行的命令（可选）
    "postCreateCommand": ". /opt/ros/noetic/setup.bash && if [ -f devel/setup.bash ]; then . devel/setup.bash; fi",
    // 推荐给容器装的 VS Code 插件
    "customizations": {
        "vscode": {
            "plugins": [
                "ms-iot.vscode-ros",
                "ms-vscode.cpptools",
                "twxs.cmake"
            ],
            "extensions": [
                "Anthropic.claude-code"
            ],
        }
    }
}